rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User profiles
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId);
      allow update: if isAuthenticated() && (
        isOwner(userId) ||
        // Allow mutual buddy updates & presence updates
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['buddyIds', 'status', 'lastSeen'])
      );
      allow delete: if false;
    }

    // Chat Rooms: Group Chats and Direct DMs
    match /rooms/{roomId} {
      allow read: if isAuthenticated() && (
        resource == null ||
        resource.data.type == 'group' ||
        !('participantIds' in resource.data) ||
        resource.data.participantIds.size() == 0 ||
        request.auth.uid in resource.data.participantIds
      );
      allow create: if isAuthenticated() && (
        request.resource.data.createdBy == request.auth.uid ||
        request.auth.uid in request.resource.data.participantIds
      );
      allow update: if isAuthenticated() && (
        resource.data.type == 'group' ||
        request.auth.uid in resource.data.participantIds ||
        request.auth.uid in request.resource.data.participantIds
      );
      allow delete: if isAuthenticated() && resource.data.createdBy == request.auth.uid;

      // Messages in a room
      match /messages/{messageId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && request.resource.data.senderId == request.auth.uid;
        allow update: if isAuthenticated() && (
          // Reactions, read receipts, or message edits
          request.resource.data.diff(resource.data).affectedKeys().hasAny(['reactions', 'readBy', 'readAt', 'content', 'isPinned'])
        );
        allow delete: if isAuthenticated() && resource.data.senderId == request.auth.uid;
      }

      // Real-time typing indicators in a room
      match /typing/{userId} {
        allow read: if isAuthenticated();
        allow write: if isOwner(userId);
      }
    }

    // 24-hour Stories collection
    match /stories/{storyId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasAny(['viewers', 'reactions'])
      );
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // WebRTC 1-on-1 Calling signaling
    match /calls/{callId} {
      allow read: if isAuthenticated() && (
        resource == null ||
        resource.data.callerId == request.auth.uid ||
        resource.data.receiverId == request.auth.uid ||
        ('participantIds' in resource.data && request.auth.uid in resource.data.participantIds)
      );
      allow create: if isAuthenticated() && (
        request.resource.data.callerId == request.auth.uid ||
        ('participantIds' in request.resource.data && request.auth.uid in request.resource.data.participantIds)
      );
      allow update: if isAuthenticated() && (
        resource.data.callerId == request.auth.uid ||
        resource.data.receiverId == request.auth.uid ||
        ('participantIds' in resource.data && request.auth.uid in resource.data.participantIds)
      );
      allow delete: if isAuthenticated() && (
        resource.data.callerId == request.auth.uid ||
        resource.data.receiverId == request.auth.uid ||
        ('participantIds' in resource.data && request.auth.uid in resource.data.participantIds)
      );

      // ICE Candidate subcollections
      match /callerCandidates/{candidateId} {
        allow read, write: if isAuthenticated();
      }
      match /receiverCandidates/{candidateId} {
        allow read, write: if isAuthenticated();
      }
    }

    // Scheduled Messages for automated background sending
    match /scheduledMessages/{scheduledMessageId} {
      allow read: if isAuthenticated() && resource.data.senderId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.senderId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.senderId == request.auth.uid;
    }

    // Buddy Requests collection
    match /buddyRequests/{requestId} {
      allow read: if isAuthenticated() && (
        resource == null ||
        resource.data.fromUserId == request.auth.uid ||
        resource.data.toUserId == request.auth.uid
      );
      allow create: if isAuthenticated() && request.resource.data.fromUserId == request.auth.uid;
      allow update, delete: if isAuthenticated() && (
        resource.data.fromUserId == request.auth.uid ||
        resource.data.toUserId == request.auth.uid
      );
    }
  }
}
